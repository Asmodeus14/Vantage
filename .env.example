# Copy to .env.local for development, or set these in your hosting dashboard.
#
# Both must point at the Vantage API. They are separate because they are
# used from different places:
#
#   BACKEND_URL             server-side only (Server Components, route handlers).
#                           Never sent to the browser, so the API origin can
#                           stay private.
#
#   NEXT_PUBLIC_BACKEND_URL sent to the browser. Required for the SSE progress
#                           stream and the ZIP upload, which cannot go through
#                           a serverless proxy: streaming responses get buffered
#                           and request bodies are capped at a few megabytes.
#
# In production these are usually the same public URL.

BACKEND_URL=http://127.0.0.1:5000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5000

# --- Sign-in (optional; all four are required together) ---
#
# Without these the product still analyses public repositories. The sign-in
# button renders disabled with the reason, rather than being hidden.
#
# The API needs its own matching set — GITHUB_CLIENT_ID, INTERNAL_API_SECRET
# and TOKEN_ENCRYPTION_KEY — plus DATABASE_URL. Configuring only one side is
# detected: /api/auth/me reports the *combined* state, so a button is never
# offered for a flow that would fail at the last step.
#
# Create an OAuth app at https://github.com/settings/developers with
# Authorization callback URL: <this-origin>/api/auth/github/callback
GITHUB_CLIENT_ID=
# Only ever used server-side, in the callback handler. Never sent to a browser.
GITHUB_CLIENT_SECRET=

# Shared with the API. Authenticates this server when it exchanges a GitHub
# token for a session — not a user credential. Must match the API's value.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_SECRET=

# Signs the OAuth `state` parameter. Stateless, so sign-in survives multiple
# server instances. Rotating it invalidates in-flight sign-ins only.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
